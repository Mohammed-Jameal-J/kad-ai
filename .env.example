# Copy to .env and adjust. Never commit .env.

# Backend (FastAPI) ------------------------------------------------------------
# Default: SQLite file at backend/kadai.db
# DATABASE_URL=sqlite:///C:/Users/you/Desktop/kad_ai/backend/kadai.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_REQUEST_BYTES=65536

# Frontend (Next.js) -----------------------------------------------------------
# Server-only; put it in frontend/.env.local if FastAPI is not on the default address.
# API_URL=http://127.0.0.1:8000

# Local AI (Ollama), used from Stage 3 -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 here too = one model, no swaps: every reply under ~22 s on a 12 GB laptop (see docs/architecture.md)
OLLAMA_INTENT_MODEL=qwen3:4b
OLLAMA_RESPONSE_MODEL=llama3.2
# Optional CrewAI workflow (Stage 8): one model for all agents
OLLAMA_CREW_MODEL=llama3.2
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=180
# How long a model stays in RAM after a call; "0" unloads immediately (saves RAM, slower next call)
OLLAMA_KEEP_ALIVE=30m
# Load the intent model at startup so the first chat is fast
OLLAMA_PREWARM=true
# Context window; smaller uses less RAM
OLLAMA_NUM_CTX=4096

# Abuse protection ---------------------------------------------------------------
# Chat requests per client IP per minute
CHAT_PER_MINUTE=10
# Requests allowed to wait for the busy model; more get 503 "busy" immediately
OLLAMA_MAX_WAITING=3
OLLAMA_QUEUE_WAIT=90
# Slow multi-agent endpoint, off by default
CREW_ENABLED=false
# Only when deployed behind an edge that overwrites it with the real client IP (Vercel: x-real-ip)
# TRUSTED_IP_HEADER=x-real-ip
# HTTPS deployments: send the session cookie only over HTTPS
# COOKIE_SECURE=true

# Email (Resend, https://resend.com) ---------------------------------------------
# Empty = emails are skipped. Secret: put it only in .env / your host's settings, never in git.
# RESEND_API_KEY=re_xxxxxxxx
# onboarding@resend.dev only delivers to your own Resend account email. Verify a domain in Resend
# to send to anyone, then e.g. EMAIL_FROM="Kad AI <hello@yourdomain.com>"
# EMAIL_FROM=Kad AI <onboarding@resend.dev>
# SITE_URL=http://localhost:3000

# Hosted AI for deployments without Ollama (Groq, https://console.groq.com) -------
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxx              (secret)
# GROQ_INTENT_MODEL=openai/gpt-oss-20b
# GROQ_RESPONSE_MODEL=openai/gpt-oss-120b
# GROQ_DAILY_LIMIT=500                   (all visitors together; over it: rules only)

# Web search for general produce questions (Serper, https://serper.dev) ------------
# Never used for prices, stock or nutrition numbers. Empty = off.
# SERPER_API_KEY=xxxxxxxx                 (secret)
# SEARCH_DAILY_LIMIT=100
# SEARCH_PER_IP_PER_HOUR=5
